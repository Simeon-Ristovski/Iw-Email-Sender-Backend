<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="10" author="Simeon">
        <insert tableName="role">
            <column name="role_name" value="ADMINISTRATOR"></column>
        </insert>
        <insert tableName="role">
            <column name="role_name" value="USER"></column>
        </insert>
        <insert tableName="repetision">
            <column name="repetision_name" value="DAILY"></column>
            <column name="in_hours" value="24"/>
        </insert>
        <insert tableName="repetision">
            <column name="repetision_name" value="WEEKLY"></column>
            <column name="in_hours" value="168"/>
        </insert>
        <insert tableName="repetision">
            <column name="repetision_name" value="MONTHLY"></column>
            <column name="in_hours" value="720"/>
        </insert>
        <insert tableName="repetision">
            <column name="repetision_name" value="YEARLY"></column>
            <column name="in_hours" value="8760"/>
        </insert>
        <insert tableName="repetision">
            <column name="repetision_name" value="HOURLY"></column>
            <column name="in_hours" value="1"/>
        </insert>

        <insert tableName="status">
            <column name="status_name" value="SUCCESS"></column>
        </insert>
        <insert tableName="status">
            <column name="status_name" value="FAILED"></column>
        </insert>
        <rollback>
            <delete tableName="role">
                <where>role_name IN ('ADMINISTRATOR', 'USER')</where>
            </delete>
            <delete tableName="repetision">
                <where>repetision_name IN ('DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY','HOURLY')</where>
            </delete>
            <delete tableName="status">
                <where>status_name IN ('SUCCESS', 'FAILED')</where>
            </delete>
        </rollback>

    </changeSet>
</databaseChangeLog>