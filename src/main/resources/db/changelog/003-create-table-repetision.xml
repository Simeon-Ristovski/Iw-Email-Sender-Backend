<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="3" author="Simeon">
        <createTable tableName="repetision">
            <column name="id"  type="BIGSERIAL">
                <constraints primaryKey="true" nullable="true"/>
            </column>
            <column name="uuid" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="true"/>
            </column>
            <column name="repetision_name" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="in_hours" type="INTEGER"/>

        </createTable>
        <rollback>
            <dropTable tableName="repetision"/>
        </rollback>

    </changeSet>


</databaseChangeLog>