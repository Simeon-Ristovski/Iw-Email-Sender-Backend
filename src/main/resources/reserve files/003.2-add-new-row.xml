<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="add-in_hours-column" author="Simeon">
        <addColumn tableName="repetision">
            <column name="in_hours" type="INTEGER"/>
        </addColumn>

        <update tableName="repetision">
            <column name="in_hours" value="24"/>
            <where>repetision = 'DAILY'</where>
        </update>

        <update tableName="repetision">
            <column name="in_hours" value="168"/>
            <where>repetision = 'WEEKLY'</where>
        </update>

        <update tableName="repetision">
            <column name="in_hours" value="720"/>
            <where>repetision = 'MONTHLY'</where>
        </update>

        <update tableName="repetision">
            <column name="in_hours" value="8760"/>
            <where>repetision = 'YEARLY'</where>
        </update>
    </changeSet>

</databaseChangeLog>
