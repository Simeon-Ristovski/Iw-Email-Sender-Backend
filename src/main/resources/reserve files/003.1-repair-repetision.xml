<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- 1. Поставување default UUID за идни редови -->
    <changeSet id="set-default-uuid" author="Simeon">
        <addDefaultValue tableName="repetision" columnName="id" defaultValueComputed="gen_random_uuid()"/>
    </changeSet>

    <!-- 2. Пополнување постоечки NULL UUID редови без бришење child таблици -->
    <changeSet id="populate-existing-uuid" author="Simeon">
        <sql>
            UPDATE repetision SET id = gen_random_uuid() WHERE id IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
